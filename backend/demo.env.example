# Copy settings into the hosting environment; no key is required for a complete demo.
LLM_ENABLED=false
SEED_SAMPLE_DATA=true
# Optional absolute path on a mounted persistent disk. Directory must exist.
# DEMO_DB_PATH=/var/data/clinical-demo/audit.db
DEMO_MAX_REQUEST_BYTES=16384
DEMO_WRITES_PER_MINUTE=20
DEMO_GLOBAL_WRITES_PER_MINUTE=120
DEMO_WRITE_CONCURRENCY=2
DEMO_MAX_ALERTS=1000
DEMO_MAX_REVIEW_RECORDS=10000
# ALLOWED_ORIGINS=https://your-frontend.example
